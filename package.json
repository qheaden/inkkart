{
  "name": "inkkart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --outdir ./dist --target browser && cp index.html dist/",
    "serve": "bun ./src/server.ts",
    "start": "bun run build && bun run serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
